# Copy to .env.local (gitignored). Never commit real secrets.
# Prisma CLI also needs DATABASE_URL in a plain .env file for local Postgres.

# Local Postgres (used when DATABASE_HOST is unset):
DATABASE_URL="postgresql://user:password@localhost:5432/kirbo_autolister"

# Aurora Express (IAM only — no static DB password).
# App-on-Aurora: set DATABASE_HOST (+ NAME/USER). The app then mints IAM tokens.
# DATABASE_HOST="your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com"
# DATABASE_PORT="5432"
# DATABASE_NAME="kirbo_autolister"
# DATABASE_USER="postgres"
# pgAdmin / `npm run db:token` without switching the app off localhost:
# AURORA_HOST="your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com"
# AURORA_DB="kirbo_autolister"
# AURORA_USER="postgres"
# AWS_DATABASE_PROFILE="kirbo-console"   # local only; omit in production (use IAM role)

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Local smoke-test login (also test-credentials.local.json). Used by npm run smoke:login
# and the browser-smoke-test agent skill — never commit real passwords.
# TEST_USER_IDENTIFIER="testuser"
# TEST_USER_PASSWORD=""

# Encrypts eBay OAuth tokens at rest - generate with: openssl rand -base64 32
EBAY_TOKEN_ENCRYPTION_KEY=""

# eBay Sandbox — https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RUNAME=""
EBAY_SANDBOX="true"
EBAY_API_URL="https://api.sandbox.ebay.com"
EBAY_REDIRECT_URI="http://localhost:3000/api/ebay/callback"
EBAY_MARKETPLACE_ID="EBAY_US"

# TEMPORARY fallback category used when a listing doesn't have its own
# eBay category chosen in the UI. 175687 = "Cell Phone Accessories >
# Cases, Covers & Skins" - a real leaf category that supports/displays
# `condition` and only requires Brand + MPN as item specifics, both of
# which lib/ebay/utils.ts's buildEbayAspects() supplies automatically
# (defaulting to "Unbranded"/"Does Not Apply"). See docs/ebay-api-reference.md.
# Real production listings still need a real per-product category (via the
# Taxonomy API's getCategorySuggestions) - most categories require their
# own specific aspects (Size, Color, etc.) that this fallback can't provide.
EBAY_DEFAULT_CATEGORY_ID="175687"

# --- Required before going to eBay production (see EBAY_SETUP.md #7) ---
# Marketplace Account Deletion notification endpoint - eBay won't approve
# production API access without this configured and verified.
EBAY_VERIFICATION_TOKEN=""
EBAY_NOTIFICATION_ENDPOINT_URL="https://your-production-domain.com/api/webhooks/ebay/account-deletion"

# Product image uploads. Browser PUTs via a presigned URL; eBay reads the public object.
# Region and bucket are required everywhere. The access key pair is for local dev only.
# On a deployed app, leave the keys unset and attach an IAM role to the service instead.
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Depop Selling API (partner-gated — email business@depop.com) ---
# See docs/depop-api-reference.md. Paste the key in the Platforms UI; these
# env vars are only for `npm run integrations:verify` smoke tests.
# DEPOP_VERIFY_API_KEY=""
# DEPOP_VERIFY_ENVIRONMENT="staging"   # or production
# Optional taxonomy defaults until the product form collects Depop fields:
# DEPOP_DEFAULT_DEPARTMENT="menswear"
# DEPOP_DEFAULT_PRODUCT_TYPE="tshirts"
# DEPOP_DEFAULT_SIZE_SET_ID="52"
# DEPOP_DEFAULT_SIZE_ID="10"
# DEPOP_DEFAULT_COUNTRY="US"
# DEPOP_DEFAULT_CURRENCY="USD"
# DEPOP_API_BASE_URL=""                # override host if Depop gives a custom one

# --- Etsy Open API v3 (https://www.etsy.com/developers/your-apps) ---
# See docs/etsy-api-reference.md. Callback must be HTTPS and match exactly.
# ETSY_API_KEYSTRING=""
# ETSY_SHARED_SECRET=""
# ETSY_REDIRECT_URI="https://your-tunnel.trycloudflare.com/api/etsy/callback"
# ETSY_SCOPES="listings_r listings_w shops_r"
# Leaf taxonomy id from GET /v3/application/seller-taxonomy/nodes (required for drafts)
# ETSY_DEFAULT_TAXONOMY_ID="1"
# ETSY_DEFAULT_WHO_MADE="someone_else"
# ETSY_DEFAULT_WHEN_MADE="2010_2019"
# Optional — needed to auto-activate physical listings after draft + images:
# ETSY_SHIPPING_PROFILE_ID=""
# ETSY_READINESS_STATE_ID=""
