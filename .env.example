# eBay API Configuration
EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_cert_id_here
EBAY_DEV_ID=your_dev_id_here
EBAY_RUNAME=your_runame_here

# eBay OAuth URLs
EBAY_OAUTH_URL=https://auth.ebay.com/oauth2/authorize
EBAY_API_URL=https://api.ebay.com
EBAY_SANDBOX_API_URL=https://api.sandbox.ebay.com

# eBay Scopes
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account 