# Copy this file to .env.local (and copy the DATABASE_URL line to a plain
# .env too, since the Prisma CLI doesn't read .env.local) and fill in real
# values. See EBAY_SETUP.md for the full eBay setup walkthrough.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/kirbo_autolister"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- eBay Sandbox OAuth (see EBAY_SETUP.md) ---
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RUNAME=""
EBAY_SANDBOX="true"
EBAY_API_URL="https://api.sandbox.ebay.com"
EBAY_REDIRECT_URI="http://localhost:3000/api/ebay/callback"
EBAY_MARKETPLACE_ID="EBAY_US"
EBAY_DEFAULT_CATEGORY_ID="171485"

# Optional overrides for the auto-created inventory location:
# EBAY_MERCHANT_LOCATION_KEY=""
# EBAY_MERCHANT_LOCATION_COUNTRY="US"
# EBAY_MERCHANT_LOCATION_POSTAL_CODE=""
# EBAY_MERCHANT_LOCATION_STATE=""
# EBAY_MERCHANT_LOCATION_CITY=""

# Only needed if you wire up eBay platform notifications:
# EBAY_WEBHOOK_SIGNING_KEY=""

# --- AWS S3 (only needed if you switch image uploads to use /api/upload) ---
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME=""
